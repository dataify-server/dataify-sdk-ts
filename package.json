{
  "name": "dataify-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Dataify API Key based Scraper, SERP, and Web Unlocker runtime APIs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-tools.cjs"
  },
  "keywords": [
    "dataify",
    "sdk",
    "scraper",
    "serp",
    "web-unlocker"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}